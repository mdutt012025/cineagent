<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Netflix Clone</title>
  <link rel="icon" href="https://assets.nflxext.com/us/ffe/siteui/common/icons/nficon2016.ico" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <style>
    /* ===================== */
    /* DESIGN TOKENS         */
    /* ===================== */
    :root {
      --red:       #e50914;
      --red-hover: #c40812;
      --bg:        #141414;
      --surface:   #1f1f1f;
      --surface2:  #2a2a2a;
      --border:    #333;
      --text:      #e5e5e5;
      --muted:     #a0a0a0;
      --white:     #ffffff;
      --header-h:  68px;

      --font-display: 'Bebas Neue', sans-serif;
      --font-body:    'DM Sans', sans-serif;

      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in:  cubic-bezier(0.7, 0, 0.84, 0);

      --r-sm: 4px;
      --r-md: 8px;
      --r-lg: 12px;
    }

    /* ===================== */
    /* RESET & BASE          */
    /* ===================== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-weight: 400;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }
    button { font-family: var(--font-body); cursor: pointer; }
    img { display: block; max-width: 100%; }

    .hidden { display: none !important; }

    /* ===================== */
    /* NOTIFICATION TOAST    */
    /* ===================== */
    #toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--white);
      padding: 12px 24px;
      border-radius: 50px;
      font-size: 0.9rem;
      font-weight: 500;
      opacity: 0;
      transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
      z-index: 9999;
      white-space: nowrap;
      pointer-events: none;
      backdrop-filter: blur(10px);
    }
    #toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ===================== */
    /* LANDING PAGE          */
    /* ===================== */
    #landing-page {
      min-height: 100vh;
    }

    /* Hero */
    .lp-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background:
        linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.8) 100%),
        url("https://assets.nflxext.com/ffe/siteui/vlv3/8ef88e03-6f89-4c75-ae51-f8da7d252358/6ac07e5f-07ca-4543-8540-f22edce8bb02/TW-en-20210208-popsignuptwoweeks-perspective_alpha_website_small.jpg")
        no-repeat center center / cover;
      border-bottom: 8px solid var(--border);
    }

    /* Landing Navbar */
    .lp-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 4%;
    }
    .lp-nav .netflix-logo {
      width: 140px;
    }
    .lp-sign-in {
      background: var(--red);
      color: var(--white);
      padding: 8px 20px;
      border-radius: var(--r-sm);
      font-size: 1rem;
      font-weight: 500;
      transition: background 0.2s;
    }
    .lp-sign-in:hover { background: var(--red-hover); }

    /* Hero Content */
    .lp-hero-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 20px 80px;
    }
    .lp-hero-body h1 {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 6vw, 4.5rem);
      letter-spacing: 0.03em;
      line-height: 1.05;
      margin-bottom: 20px;
      color: var(--white);
    }
    .lp-hero-body p {
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--text);
      margin-bottom: 36px;
      max-width: 600px;
      font-weight: 300;
    }
    .lp-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--red);
      color: var(--white);
      font-size: 1.3rem;
      font-weight: 700;
      padding: 14px 36px;
      border-radius: var(--r-sm);
      transition: background 0.2s, transform 0.2s var(--ease-out);
    }
    .lp-cta:hover {
      background: var(--red-hover);
      transform: scale(1.03);
    }

    /* Showcase Sections */
    .lp-showcase {
      border-bottom: 8px solid var(--border);
      padding: 70px 4%;
    }
    .lp-showcase-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 40px;
    }
    .lp-showcase-inner.reverse { flex-direction: row-reverse; }
    .lp-showcase-text { flex: 1; }
    .lp-showcase-text h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: 0.02em;
      line-height: 1.1;
      color: var(--white);
      margin-bottom: 16px;
    }
    .lp-showcase-text p {
      font-size: 1.1rem;
      color: var(--text);
      line-height: 1.7;
      font-weight: 300;
    }
    .lp-showcase-media {
      flex: 1;
      position: relative;
    }
    .lp-showcase-media img { width: 100%; }
    .lp-showcase-media video {
      position: absolute;
      z-index: -1;
    }
    .lp-showcase-media.tv-media video {
      width: 73%; height: 54%;
      left: 13%; top: 21%;
    }
    .lp-showcase-media.devices-media video {
      width: 63%; height: 48%;
      top: 10%; left: 18%;
    }

    /* Download card */
    .download-card {
      position: absolute;
      bottom: 12%;
      left: 50%;
      transform: translateX(-50%);
      background: #000;
      border: 2px solid var(--border);
      border-radius: var(--r-md);
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      width: 70%;
      z-index: 2;
    }
    .download-card img { height: 60px; border-radius: 4px; }
    .download-card .dc-text { flex: 1; }
    .download-card .dc-text strong { color: var(--white); font-size: 0.95rem; }
    .download-card .dc-text span { color: #0071eb; font-size: 0.85rem; display: block; margin-top: 2px; }
    .download-card .dc-anim {
      display: flex;
      gap: 4px;
      align-items: flex-end;
    }
    .download-card .dc-anim span {
      width: 5px;
      background: var(--red);
      border-radius: 2px;
      animation: equalize 1.2s ease-in-out infinite alternate;
    }
    .download-card .dc-anim span:nth-child(1) { height: 10px; animation-delay: 0s; }
    .download-card .dc-anim span:nth-child(2) { height: 20px; animation-delay: 0.2s; }
    .download-card .dc-anim span:nth-child(3) { height: 14px; animation-delay: 0.4s; }
    @keyframes equalize {
      to { height: 4px; }
    }

    /* FAQ */
    .lp-faq {
      border-bottom: 8px solid var(--border);
      padding: 70px 4%;
    }
    .lp-faq h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: 0.02em;
      text-align: center;
      color: var(--white);
      margin-bottom: 30px;
    }
    .faq-list {
      max-width: 720px;
      margin: 0 auto 40px;
    }
    .faq-item {
      background: var(--surface);
      margin-bottom: 6px;
      border-radius: var(--r-sm);
      overflow: hidden;
      cursor: pointer;
    }
    .faq-item summary {
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 24px;
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--white);
      user-select: none;
    }
    .faq-item summary .faq-icon {
      font-size: 1.8rem;
      transition: transform 0.3s var(--ease-out);
      line-height: 1;
      color: var(--muted);
    }
    .faq-item[open] summary .faq-icon { transform: rotate(45deg); color: var(--white); }
    .faq-item p {
      padding: 0 24px 22px;
      color: var(--text);
      font-size: 1rem;
      line-height: 1.7;
      font-weight: 300;
    }
    .faq-cta-wrap { text-align: center; margin-top: 40px; }

    /* Landing Footer */
    .lp-footer {
      color: var(--muted);
      padding: 50px 4%;
      max-width: 1100px;
      margin: 0 auto;
    }
    .lp-footer > p { margin-bottom: 20px; font-size: 0.95rem; }
    .lp-footer-links {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 10px;
      margin-bottom: 24px;
    }
    .lp-footer-links li {
      font-size: 0.85rem;
      cursor: pointer;
      transition: color 0.2s;
    }
    .lp-footer-links li:hover { color: var(--text); text-decoration: underline; }
    .lp-lang-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--muted);
      border-radius: var(--r-sm);
      padding: 8px 16px;
      font-size: 0.9rem;
      color: var(--muted);
      background: transparent;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .lp-lang-btn:hover { border-color: var(--text); color: var(--text); }

    /* ===================== */
    /* MAIN / BROWSE PAGE    */
    /* ===================== */
    #main-page { min-height: 100vh; }

    /* Fixed Header */
    #header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-h);
      z-index: 500;
      display: flex;
      align-items: center;
      transition: background 0.4s var(--ease-out);
    }
    #header.scrolled { background: var(--bg); }
    #header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.75) 0%, transparent 100%);
      pointer-events: none;
      opacity: 1;
      transition: opacity 0.4s;
    }
    #header.scrolled::before { opacity: 0; }

    .header-inner {
      width: 100%;
      padding: 0 4%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 1;
    }
    .header-left { display: flex; align-items: center; gap: 30px; }
    .header-logo { height: 32px; width: auto; }

    .main-nav {
      display: flex;
      gap: 20px;
    }
    .main-nav li {
      font-size: 0.9rem;
      color: var(--text);
      cursor: pointer;
      transition: color 0.2s;
      position: relative;
    }
    .main-nav li:hover { color: var(--white); }
    .main-nav li.active {
      color: var(--white);
      font-weight: 700;
    }
    .main-nav li.active::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0; right: 0;
      height: 2px;
      background: var(--red);
      border-radius: 2px;
    }

    .header-right { display: flex; align-items: center; gap: 18px; }
    .search-btn {
      background: none;
      border: none;
      color: var(--white);
      font-size: 1.1rem;
      cursor: pointer;
      opacity: 0.85;
      transition: opacity 0.2s;
    }
    .search-btn:hover { opacity: 1; }
    .avatar {
      width: 34px; height: 34px;
      border-radius: var(--r-sm);
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .avatar:hover { opacity: 0.8; }

    /* ===================== */
    /* BANNER                */
    /* ===================== */
    .banner {
      height: 90vh;
      min-height: 500px;
      position: relative;
      display: flex;
      align-items: flex-end;
      padding: 0 4% 80px;
      background-size: cover;
      background-position: center top;
      overflow: hidden;
    }
    .banner::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(20,20,20,0.85) 0%, rgba(20,20,20,0.3) 60%, transparent 100%),
        linear-gradient(180deg, rgba(20,20,20,0.3) 0%, transparent 40%, rgba(20,20,20,1) 100%);
    }
    .banner-content {
      position: relative;
      z-index: 2;
      max-width: 480px;
      animation: fadeUp 0.8s var(--ease-out) both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .banner-content h1 {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5vw, 4rem);
      letter-spacing: 0.02em;
      line-height: 1.05;
      color: var(--white);
      margin-bottom: 14px;
      text-shadow: 0 2px 20px rgba(0,0,0,0.5);
    }
    .banner-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .banner-rating {
      font-size: 0.85rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 3px;
      color: var(--white);
    }
    .banner-rating.high { background: #2ecc71; }
    .banner-rating.med  { background: #f39c12; }
    .banner-rating.low  { background: #e74c3c; }
    .banner-year { font-size: 0.85rem; color: var(--muted); }
    .banner-content p {
      font-size: 0.95rem;
      color: var(--text);
      line-height: 1.6;
      margin-bottom: 24px;
      font-weight: 300;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .banner-btns {
      display: flex;
      gap: 12px;
    }
    .banner-btns button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 26px;
      border-radius: var(--r-sm);
      border: none;
      font-size: 0.95rem;
      font-weight: 700;
      font-family: var(--font-body);
      transition: transform 0.2s var(--ease-out), background 0.2s;
    }
    .banner-btns button:hover { transform: scale(1.04); }
    .btn-play {
      background: var(--white);
      color: #000;
    }
    .btn-play:hover { background: rgba(255,255,255,0.85) !important; }
    .btn-mylist {
      background: rgba(109,109,110,0.7);
      color: var(--white);
      backdrop-filter: blur(4px);
    }
    .btn-mylist:hover { background: rgba(109,109,110,0.9) !important; }

    /* ===================== */
    /* MOVIE SECTIONS / ROWS */
    /* ===================== */
    .browse-content {
      padding-bottom: 60px;
    }
    .movie-section {
      padding: 0 4%;
      margin-top: 40px;
    }
    .movie-section h2 {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 12px;
      letter-spacing: 0.01em;
    }
    .movie-row-wrapper { position: relative; }
    .movie-row {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      padding-bottom: 6px;
    }
    .movie-row::-webkit-scrollbar { display: none; }

    /* Scroll arrows */
    .scroll-arrow {
      position: absolute;
      top: 0; bottom: 6px;
      width: 50px;
      background: rgba(20,20,20,0.7);
      border: none;
      color: var(--white);
      font-size: 1.4rem;
      cursor: pointer;
      z-index: 10;
      opacity: 0;
      transition: opacity 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .movie-row-wrapper:hover .scroll-arrow { opacity: 1; }
    .scroll-arrow.left { left: 0; }
    .scroll-arrow.right { right: 0; }
    .scroll-arrow:hover { background: rgba(20,20,20,0.95); }

    /* Movie Card */
    .movie-card {
      min-width: 220px;
      height: 130px;
      border-radius: var(--r-sm);
      background-size: cover !important;
      background-position: center !important;
      background-color: var(--surface);
      position: relative;
      cursor: pointer;
      flex-shrink: 0;
      overflow: visible;
      transition: transform 0.3s var(--ease-out), z-index 0s;
    }
    .movie-card:hover {
      transform: scale(1.15);
      z-index: 50;
    }

    /* Hover overlay card */
    .card-hover {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.9) 60%);
      border-radius: var(--r-sm);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 10px;
      opacity: 0;
      transition: opacity 0.25s var(--ease-out);
      pointer-events: none;
    }
    .movie-card:hover .card-hover {
      opacity: 1;
      pointer-events: auto;
    }
    .card-hover-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 6px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .card-hover-rating {
      font-size: 0.78rem;
      color: #4ade80;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .card-hover-btns {
      display: flex;
      gap: 5px;
    }
    .card-hover-btns button {
      flex: 1;
      padding: 5px 0;
      border: none;
      border-radius: 3px;
      font-size: 0.75rem;
      font-weight: 600;
      font-family: var(--font-body);
      transition: background 0.2s;
    }
    .chb-play {
      background: var(--white);
      color: #000;
    }
    .chb-play:hover { background: rgba(255,255,255,0.85); }
    .chb-list {
      background: rgba(255,255,255,0.15);
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.4) !important;
    }
    .chb-list:hover { background: rgba(255,255,255,0.3); }

    /* ===================== */
    /* MY LIST               */
    /* ===================== */
    #my-list-section {
      padding: calc(var(--header-h) + 30px) 4% 60px;
    }
    #my-list-section h1 {
      font-family: var(--font-display);
      font-size: 2rem;
      letter-spacing: 0.02em;
      margin-bottom: 24px;
    }
    #my-list-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    #my-list-row .movie-card {
      min-width: 200px;
      height: 120px;
      transform-origin: center;
    }
    .empty-list {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 20px;
      text-align: center;
      color: var(--muted);
    }
    .empty-list i { font-size: 3rem; margin-bottom: 16px; opacity: 0.4; }
    .empty-list p { font-size: 1.1rem; }

    /* ===================== */
    /* TRAILER POPUP         */
    /* ===================== */
    #trailer-popup {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      z-index: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: fadeIn 0.3s var(--ease-out);
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    .trailer-box {
      position: relative;
      width: 85%;
      max-width: 960px;
    }
    .trailer-box iframe {
      width: 100%;
      aspect-ratio: 16/9;
      border-radius: var(--r-lg);
      border: none;
    }
    #close-trailer {
      position: absolute;
      top: -44px; right: 0;
      background: none;
      border: none;
      color: var(--white);
      font-size: 2rem;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.2s, transform 0.2s;
    }
    #close-trailer:hover { opacity: 1; transform: rotate(90deg); }

    /* ===================== */
    /* LOADING SKELETON      */
    /* ===================== */
    .skeleton {
      background: linear-gradient(90deg, var(--surface) 25%, var(--surface2) 50%, var(--surface) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: var(--r-sm);
    }
    @keyframes shimmer {
      from { background-position: 200% 0; }
      to   { background-position: -200% 0; }
    }

    /* ===================== */
    /* EMAIL MODAL           */
    /* ===================== */
    #email-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: fadeIn 0.3s var(--ease-out);
      backdrop-filter: blur(4px);
    }
    .email-modal-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 44px 40px;
      width: 90%;
      max-width: 460px;
      text-align: center;
      position: relative;
      box-shadow: 0 20px 60px rgba(0,0,0,0.7);
      animation: modalSlideUp 0.35s var(--ease-out) both;
    }
    @keyframes modalSlideUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .email-modal-box .netflix-logo-sm {
      width: 110px;
      margin: 0 auto 20px;
    }
    .email-modal-box h2 {
      font-family: var(--font-display);
      font-size: 1.9rem;
      letter-spacing: 0.03em;
      color: var(--white);
      margin-bottom: 8px;
    }
    .email-modal-box p {
