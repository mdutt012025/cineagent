  <script>
    const API_KEY = 'e950e51d5d49e85f7c2f17f01eb23ba3';
    const API    = 'https://api.themoviedb.org/3';
    const IMG    = 'https://image.tmdb.org/t/p/original';
    const IMG_SM = 'https://image.tmdb.org/t/p/w500';

    // ── DOM refs ──────────────────────────────────────
    const landingPage    = document.getElementById('landing-page');
    const mainPage       = document.getElementById('main-page');
    const header         = document.getElementById('header');
    const banner         = document.getElementById('banner');
    const browseContent  = document.getElementById('browse-content');
    const myListSection  = document.getElementById('my-list-section');
    const myListRow      = document.getElementById('my-list-row');
    const trailerPopup   = document.getElementById('trailer-popup');
    const trailerFrame   = document.getElementById('trailer-frame');
    const toast          = document.getElementById('toast');
    const emailModal     = document.getElementById('email-modal');
    const emailInput     = document.getElementById('email-input');
    const headerUserEmail = document.getElementById('header-user-email');

    let myList = JSON.parse(localStorage.getItem('nfMyList') || '[]');
    let initialized = false;
    let toastTimer;
    let globalSeen = new Set();

    // ── Toast ─────────────────────────────────────────
    function showToast(msg) {
      clearTimeout(toastTimer);
      toast.textContent = msg;
      toast.classList.add('show');
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2800);
    }

    // ── Email Validation ─────────────────────────────
    function validateEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim());
    }

    // ── Email Modal Logic ─────────────────────────────
    function openEmailModal(e) {
      if (e) e.preventDefault();
      emailInput.value = '';
      emailModal.classList.remove('hidden');
      setTimeout(() => emailInput.focus(), 100);
    }

    function closeEmailModal() {
      emailModal.classList.add('hidden');
      emailInput.value = '';
    }

    function handleEmailSubmit() {
      const email = emailInput.value.trim();
      if (!validateEmail(email)) {
        showToast('Please enter a valid email address.');
        emailInput.focus();
        return;
      }
      localStorage.setItem('nfUserEmail', email);
      headerUserEmail.textContent = email;
      closeEmailModal();
      goToMain();
    }

    document.getElementById('email-modal-submit').addEventListener('click', handleEmailSubmit);
    document.getElementById('email-modal-close').addEventListener('click', closeEmailModal);

    // Close modal on background click
    emailModal.addEventListener('click', e => {
      if (e.target === emailModal) closeEmailModal();
    });

    // Submit on Enter key
    emailInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') handleEmailSubmit();
    });

    // ── Button wiring (open modal instead of goToMain) ─
    document.getElementById('get-started-btn').addEventListener('click', openEmailModal);
    document.getElementById('get-started-btn2').addEventListener('click', openEmailModal);
    document.getElementById('sign-in-btn').addEventListener('click', openEmailModal);

    // ── Auto-login if email already saved ────────────
    const savedEmail = localStorage.getItem('nfUserEmail');
    if (savedEmail) {
      headerUserEmail.textContent = savedEmail;
      landingPage.classList.add('hidden');
      mainPage.classList.remove('hidden');
      if (!initialized) { init(); initialized = true; }
    }

    // ── Page transition ───────────────────────────────
    function goToMain(e) {
      if (e) e.preventDefault();
      landingPage.classList.add('hidden');
      mainPage.classList.remove('hidden');
      if (!initialized) { init(); initialized = true; }
    }

    // ── Scroll → header background ───────────────────
    window.addEventListener('scroll', () => {
      if (!mainPage.classList.contains('hidden')) {
        header.classList.toggle('scrolled', window.scrollY > 60);
      }
    });

    // ── Navigation ───────────────────────────────────
    document.querySelectorAll('.main-nav li').forEach(li => {
      li.addEventListener('click', () => {
        document.querySelectorAll('.main-nav li').forEach(l => l.classList.remove('active'));
        li.classList.add('active');
        const view = li.dataset.view;
        globalSeen.clear();

        if (view === 'mylist') {
          banner.style.display = 'none';
          browseContent.classList.add('hidden');
          myListSection.classList.remove('hidden');
          renderMyList();
        } else {
          banner.style.display = 'none';
          browseContent.classList.remove('hidden');
          myListSection.classList.add('hidden');
          browseContent.innerHTML = '';
          if (view === 'home') {
            loadBannerByType('home');
            loadHome();
          }

          if (view === 'tvshows') {
            loadBannerByType('tv');
            loadTVShows();
          }

          if (view === 'movies') {
            loadBannerByType('movie');
            loadMovies();
         }
        }
      });
    });

    // ── Trailer cache (id → key or null) ─────────────
    const trailerCache = {};

    async function hasTrailer(id, type = 'movie') {
      if (trailerCache[id] !== undefined) return trailerCache[id];
      try {
        const res  = await fetch(`${API}/${type}/${id}/videos?api_key=${API_KEY}`);
        const data = await res.json();
        const clip = (data.results || []).find(v =>
          v.site === 'YouTube' && (v.type === 'Trailer' || v.type === 'Teaser')
        );
        trailerCache[id] = clip ? clip.key : null;
        return trailerCache[id];
      } catch {
        trailerCache[id] = null;
        return null;
      }
    }

    // Filter items to only those with trailers (checks in parallel, up to limit)
    async function filterWithTrailers(items, type = 'movie', need = 18) {
      const result = [];
      for (const item of items) {
        if (result.length >= need) break;
        const key = await hasTrailer(item.id, type);
        if (key) result.push(item);
      }
      return result;
    }

    // ── Fetch helpers ─────────────────────────────────
    async function apiFetch(endpoint) {
      const res = await fetch(`${API}${endpoint}?api_key=${API_KEY}&language=en-US`);
      const data = await res.json();
      return data.results || data;
    }

    // Fetch multiple random pages and merge, so we have enough to filter from
    async function apiFetchQ(endpoint, query = '', pages = 2) {
      const noPage = endpoint.includes('/search/') || endpoint.includes('/trending/');
      const allResults = [];
      const usedPages = new Set();

      const totalPages = noPage ? 1 : pages;
      for (let i = 0; i < totalPages; i++) {
        let page;
        if (noPage) {
          page = 1;
        } else {
          do { page = Math.floor(Math.random() * 8) + 1; } while (usedPages.has(page));
          usedPages.add(page);
        }
        const sep = endpoint.includes('?') ? '&' : '?';
        const pageParam = noPage ? '' : `&page=${page}`;
        try {
          const res  = await fetch(`${API}${endpoint}${sep}api_key=${API_KEY}&language=en-US${query}${pageParam}`);
          const data = await res.json();
          allResults.push(...(data.results || []));
        } catch { /* skip failed page */ }
      }

      // Deduplicate by id
      const seen = new Set();
      return allResults.filter(item => {
        if (seen.has(item.id)) return false;
        seen.add(item.id);
        return true;
      });
    }

    // ── Init ─────────────────────────────────────────
    async function init() {
      banner.style.display = 'none';  // ✅ hide initially
      await loadBannerByType('home');
      loadHome();
    }

    // ── Banner ───────────────────────────────────────
    function setBanner(movie) {
      banner.style.display = 'flex';
      const title  = movie.title || movie.name || 'Untitled';
      const rating = movie.vote_average || 0;
      const year   = (movie.release_date || movie.first_air_date || '').slice(0, 4);
      const overview = movie.overview ? movie.overview.slice(0, 200) + '…' : '';

      let rClass, rLabel;
      if (rating >= 7.5)      { rClass = 'high'; rLabel = `★ ${rating.toFixed(1)}`; }
      else if (rating >= 5.5) { rClass = 'med';  rLabel = `★ ${rating.toFixed(1)}`; }
      else                    { rClass = 'low';  rLabel = `★ ${rating.toFixed(1)}`; }

      banner.style.backgroundImage = `url(${IMG}${movie.backdrop_path})`;

      const listed = myList.includes(title);
      banner.innerHTML = `
        <div class="banner-content">
          <h1>${title}</h1>
          <div class="banner-meta">
            <span class="banner-rating ${rClass}">${rLabel}</span>
            ${year ? `<span class="banner-year">${year}</span>` : ''}
          </div>
          <p>${overview}</p>
          <div class="banner-btns">
            <button class="btn-play" onclick="playTrailer(${movie.id})">▶ &nbsp;Play</button>
            <button class="btn-mylist" id="banner-list-btn" onclick="toggleMyList('${title.replace(/'/g,"\\'")}', this)">
              ${listed ? '✔ My List' : '+ My List'}
            </button>
          </div>
        </div>
      `;
    }
    async function loadBannerByType(type) {
        try {
            let data;

            if (type === 'movie') {
                data = await apiFetch('/movie/top_rated');
            } else if (type === 'tv') {
                data = await apiFetch('/tv/top_rated');
            } else {
                data = await apiFetch('/trending/movie/week');
            }

            const candidates = data.filter(i => i.backdrop_path);

            if (!candidates.length) return;

            const pick = candidates[Math.floor(Math.random() * 5)];

            setBanner(pick);
        } catch {
            console.log('Banner load failed');
        }
    }

    // ── Section loaders ───────────────────────────────
    // Each tab fetches ONLY its own media type. Home uses unique trending/curated
    // endpoints that don't overlap with Movies or TV tabs.

    async function loadHome() {
      // Home uses /trending/all (mixed) + curated genre picks — 
      // NOT the same endpoints as Movies or TV tabs
      const homeSections = [
        { title: 'Trending Movies', url: '/trending/movie/week', type: 'movie' },
        { title: 'Trending TV', url: '/trending/tv/week', type: 'tv' },
        { title: 'Netflix Originals',     url: '/discover/tv',   extra: '&with_networks=213', type: 'tv' },
        { title: 'Award-Winning Films',   url: '/discover/movie', extra: '&sort_by=vote_average.desc&vote_count.gte=5000', type: 'movie' },
        { title: 'Binge-Worthy Series',   url: '/discover/tv',   extra: '&sort_by=vote_average.desc&vote_count.gte=1000', type: 'tv' },
        { title: 'Blockbuster Action',    url: '/discover/movie', extra: '&with_genres=28&sort_by=revenue.desc', type: 'movie' },
        { title: 'Must-Watch Documentaries', url: '/discover/movie', extra: '&with_genres=99&sort_by=vote_average.desc&vote_count.gte=500', type: 'movie' },
        { title: 'Fan-Favorite Anime',    url: '/discover/tv',   extra: '&with_genres=16&with_original_language=en', type: 'tv' },
        { title: 'Critically Acclaimed',  url: '/discover/movie', extra: '&sort_by=vote_average.desc&vote_count.gte=8000', type: 'movie' },
      ];
      const pageUsed = new Set();
      for (const s of homeSections) {
        const raw = await apiFetchQ(s.url, s.extra || '', 2);
        const mediaType = s.type === 'auto' ? null : s.type;
        const filtered = await filterWithTrailers(
          raw.filter(i => i.backdrop_path && !globalSeen.has(i.id)),
          mediaType,
          18
        );
        if (filtered.length) {
            filtered.forEach(i => globalSeen.add(i.id));
            buildSection(s.title, filtered);
        }
      }
    }

    async function loadTVShows() {
      // ONLY /tv and /trending/tv endpoints — never /movie
      const tvSections = [
        { title: 'Trending TV Shows',       url: '/trending/tv/week' },
        { title: 'Top Rated Series',        url: '/tv/top_rated' },
        { title: 'Popular Right Now',       url: '/tv/popular' },
        { title: 'Drama Series',            url: '/discover/tv', extra: '&with_genres=18' },
        { title: 'Comedy Shows',            url: '/discover/tv', extra: '&with_genres=35' },
        { title: 'Crime & Mystery',         url: '/discover/tv', extra: '&with_genres=80' },
        { title: 'Sci-Fi & Fantasy',        url: '/discover/tv', extra: '&with_genres=10765' },
        { title: 'Action & Adventure',      url: '/discover/tv', extra: '&with_genres=10759' },
        { title: 'Reality TV',              url: '/discover/tv', extra: '&with_genres=10764' },
        { title: 'Thriller Series',         url: '/discover/tv', extra: '&with_genres=9648' },
      ];
      const seenInTab = new Set();
      for (const s of tvSections) {
        const raw = (await apiFetchQ(s.url, s.extra || '', 2))
            .filter(i =>
                i.backdrop_path &&
                !seenInTab.has(i.id) &&
                !globalSeen.has(i.id)
            );
        const filtered = await filterWithTrailers(raw, 'tv', 18);
        filtered.forEach(i => {
            seenInTab.add(i.id);
            globalSeen.add(i.id);
        });
        if (filtered.length) buildSection(s.title, filtered);
      }
    }

    async function loadMovies() {
      // ONLY /movie and /trending/movie endpoints — never /tv
      const movieSections = [
        { title: 'Trending Movies',         url: '/trending/movie/week' },
        { title: 'Now Playing',             url: '/movie/now_playing' },
        { title: 'Top Rated Movies',        url: '/movie/top_rated' },
        { title: 'Popular Movies',          url: '/movie/popular' },
        { title: 'Upcoming Releases',       url: '/movie/upcoming' },
        { title: 'Action',                  url: '/discover/movie', extra: '&with_genres=28' },
        { title: 'Thriller',                url: '/discover/movie', extra: '&with_genres=53' },
        { title: 'Comedy',                  url: '/discover/movie', extra: '&with_genres=35' },
        { title: 'Horror',                  url: '/discover/movie', extra: '&with_genres=27' },
        { title: 'Science Fiction',         url: '/discover/movie', extra: '&with_genres=878' },
        { title: 'Romance',                 url: '/discover/movie', extra: '&with_genres=10749' },
        { title: 'Animation',               url: '/discover/movie', extra: '&with_genres=16' },
      ];
      const seenInTab = new Set();
      for (const s of movieSections) {
        const raw = (await apiFetchQ(s.url, s.extra || '', 2))
            .filter(i =>
                i.backdrop_path &&
                !seenInTab.has(i.id) &&
                !globalSeen.has(i.id)
            );
        const filtered = await filterWithTrailers(raw, 'movie', 18);
        filtered.forEach(i => {
            seenInTab.add(i.id);
            globalSeen.add(i.id);
        });
        if (filtered.length) buildSection(s.title, filtered);
      }
    }

    // ── Build a movie row section ─────────────────────
    function buildSection(title, items) {
      const section = document.createElement('div');
      section.className = 'movie-section';

      const rowId = 'row-' + title.replace(/\W+/g, '-').toLowerCase();

      section.innerHTML = `
        <div class="section-title-wrap">
          <h2>${title}</h2>
          <span class="see-all">Explore All ›</span>
        </div>
        <div class="movie-row-wrapper">
          <button class="scroll-arrow left" onclick="scrollRow('${rowId}', -1)">‹</button>
          <div class="movie-row" id="${rowId}">
            ${items.slice(0, 18).map(item => movieCardHTML(item)).join('')}
          </div>
          <button class="scroll-arrow right" onclick="scrollRow('${rowId}', 1)">›</button>
        </div>
      `;
      browseContent.appendChild(section);
    }

    function movieCardHTML(item) {
      const title    = (item.title || item.name || '').replace(/'/g, "\\'");
      const imgSrc   = item.backdrop_path
        ? `${IMG_SM}${item.backdrop_path}`
        : (item.poster_path ? `${IMG_SM}${item.poster_path}` : '');
      if (!imgSrc) return '';

      const rating   = item.vote_average ? item.vote_average.toFixed(1) : '?';
      const listed   = myList.includes(item.title || item.name || '');
      const listBtn  = listed ? '✔ Listed' : '+ My List';

      return `
        <div class="movie-card skeleton"
          style="background-image: url('${imgSrc}')"
          onload="this.classList.remove('skeleton')"
          title="${title}">
          <div class="card-hover">
            <div class="card-hover-title">${title}</div>
            <div class="card-hover-rating">★ ${rating}</div>
            <div class="card-hover-btns">
              <button class="chb-play" onclick="event.stopPropagation(); playTrailer(${item.id})">▶ Play</button>
              <button class="chb-list" onclick="event.stopPropagation(); toggleMyList('${title}', this)">${listBtn}</button>
            </div>
          </div>
          <div style="position:absolute;inset:0;" onclick="playTrailer(${item.id})"></div>
        </div>
      `;
    }

    // Remove skeleton once images load
    document.addEventListener('load', e => {
      if (e.target.tagName === 'IMG') {
        e.target.closest('.movie-card')?.classList.remove('skeleton');
      }
    }, true);

    // ── Row scroll ───────────────────────────────────
    function scrollRow(id, dir) {
      const row = document.getElementById(id);
      if (row) row.scrollBy({ left: dir * 800, behavior: 'smooth' });
    }

    // ── Trailer ──────────────────────────────────────
    async function playTrailer(movieId) {
      try {
        // Use cache if available, otherwise try movie then tv
        let key = trailerCache[movieId];
        if (key === undefined) {
          key = await hasTrailer(movieId, 'movie');
          if (!key) key = await hasTrailer(movieId, 'tv');
        }
        if (key) {
          trailerFrame.src = `https://www.youtube.com/embed/${key}?autoplay=1&rel=0`;
          trailerPopup.classList.remove('hidden');
        } else {
          showToast('No trailer available for this title.');
        }
      } catch {
        showToast('Could not load trailer. Please try again.');
      }
    }

    document.getElementById('close-trailer').addEventListener('click', () => {
      trailerPopup.classList.add('hidden');
      trailerFrame.src = '';
    });
    trailerPopup.addEventListener('click', e => {
      if (e.target === trailerPopup) {
        trailerPopup.classList.add('hidden');
        trailerFrame.src = '';
      }
    });

    // ── My List ──────────────────────────────────────
    function saveList() {
      localStorage.setItem('nfMyList', JSON.stringify(myList));
    }

    function toggleMyList(title, btn) {
      if (myList.includes(title)) {
        myList = myList.filter(t => t !== title);
        saveList();
        showToast(`Removed "${title}" from My List`);
        if (btn) btn.textContent = '+ My List';
        if (!myListSection.classList.contains('hidden')) renderMyList();
      } else {
        myList.push(title);
        saveList();
        showToast(`Added "${title}" to My List`);
        if (btn) btn.textContent = '✔ Listed';
      }
    }

    async function renderMyList() {
      myListRow.innerHTML = '';
      if (myList.length === 0) {
        myListRow.innerHTML = `
          <div class="empty-list">
            <i class="fa fa-heart-broken"></i>
            <p>Your list is empty — start adding some favorites!</p>
          </div>`;
        return;
      }
      for (const title of myList) {
        try {
          const res = await apiFetchQ('/search/movie', `&query=${encodeURIComponent(title)}`);
          const movie = Array.isArray(res) ? res[0] : null;
          if (!movie) continue;

          const img  = movie.backdrop_path || movie.poster_path;
          if (!img) continue;

          const card = document.createElement('div');
          card.className = 'movie-card';
          card.style.backgroundImage = `url(${IMG_SM}${img})`;

          const t = (movie.title || movie.name || title).replace(/'/g, "\\'");
          card.innerHTML = `
            <div class="card-hover">
              <div class="card-hover-title">${t}</div>
              <div class="card-hover-rating">★ ${movie.vote_average?.toFixed(1) || '?'}</div>
              <div class="card-hover-btns">
                <button class="chb-play" onclick="event.stopPropagation(); playTrailer(${movie.id})">▶ Play</button>
                <button class="chb-list" onclick="event.stopPropagation(); toggleMyList('${t}', this)">✔ Remove</button>
              </div>
            </div>
            <div style="position:absolute;inset:0;" onclick="playTrailer(${movie.id})"></div>
          `;
          myListRow.appendChild(card);
        } catch { /* skip on error */ }
      }
    }

    // ── Search Functionality ─────────────────────────

    const searchToggle = document.getElementById('search-toggle');
    const searchInput  = document.getElementById('search-input');

    searchToggle.addEventListener('click', () => {
      searchInput.classList.toggle('active');
      searchInput.classList.toggle('hidden');

      if (searchInput.classList.contains('active')) {
        searchInput.focus();
      } else {
        searchInput.value = '';
      }
    });

    let searchTimeout;

    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimeout);

      const query = searchInput.value.trim();

      searchTimeout = setTimeout(() => {
        if (query.length < 2) return;
        performSearch(query);
      }, 400);
    });

    async function performSearch(query) {
      try {
        browseContent.innerHTML = '<h2 style="padding:20px">Searching...</h2>';

        const results = await apiFetchQ(
          '/search/multi',
          `&query=${encodeURIComponent(query)}`,
          1
        );

        const filtered = results.filter(
          i => i.backdrop_path && (i.media_type === 'movie' || i.media_type === 'tv')
        );

        browseContent.innerHTML = '';

        if (!filtered.length) {
          browseContent.innerHTML = '<h2 style="padding:20px">No results found</h2>';
          return;
        }

        buildSection(`Search Results for "${query}"`, filtered);

      } catch (err) {
        console.error(err);
        showToast('Search failed');
      }
    }    

  </script>
</body>
</html>